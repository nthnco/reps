{
  "openapi": "3.1.0",
  "info": {
    "title": "Reps API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Login",
        "operationId": "login_api_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Logout",
        "operationId": "logout_api_auth_logout_post",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Me",
        "description": "Lets the frontend decide whether to show the login page.\n\n200 means \"in\": username is null when the gate is off (local dev).",
        "operationId": "me_api_auth_me_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          }
        }
      }
    },
    "/api/problems": {
      "get": {
        "tags": [
          "problems"
        ],
        "summary": "List Problems",
        "operationId": "list_problems_api_problems_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ProblemRead"
                  },
                  "type": "array",
                  "title": "Response List Problems Api Problems Get"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "problems"
        ],
        "summary": "Create Problem",
        "operationId": "create_problem_api_problems_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProblemCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemRead"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/problems/{problem_id}/attempts": {
      "post": {
        "tags": [
          "problems"
        ],
        "summary": "Create Attempt",
        "operationId": "create_attempt_api_problems__problem_id__attempts_post",
        "parameters": [
          {
            "name": "problem_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Problem Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AttemptCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AttemptRead"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/queue": {
      "get": {
        "tags": [
          "queue"
        ],
        "summary": "Todays Queue",
        "description": "Problems due today or earlier, most overdue first, then never-attempted ones.",
        "operationId": "todays_queue_api_queue_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/QueueItem"
                  },
                  "type": "array",
                  "title": "Response Todays Queue Api Queue Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AttemptCreate": {
        "properties": {
          "attempted_on": {
            "type": "string",
            "format": "date",
            "title": "Attempted On"
          },
          "solved": {
            "type": "boolean",
            "title": "Solved"
          },
          "duration_seconds": {
            "type": "integer",
            "maximum": 86400.0,
            "minimum": 0.0,
            "title": "Duration Seconds"
          },
          "confidence": {
            "type": "integer",
            "maximum": 5.0,
            "minimum": 1.0,
            "title": "Confidence"
          },
          "used_hint": {
            "type": "boolean",
            "title": "Used Hint",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "solved",
          "duration_seconds",
          "confidence"
        ],
        "title": "AttemptCreate"
      },
      "AttemptRead": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "problem_id": {
            "type": "integer",
            "title": "Problem Id"
          },
          "attempted_on": {
            "type": "string",
            "format": "date",
            "title": "Attempted On"
          },
          "solved": {
            "type": "boolean",
            "title": "Solved"
          },
          "duration_seconds": {
            "type": "integer",
            "title": "Duration Seconds"
          },
          "confidence": {
            "type": "integer",
            "title": "Confidence"
          },
          "used_hint": {
            "type": "boolean",
            "title": "Used Hint"
          }
        },
        "type": "object",
        "required": [
          "id",
          "problem_id",
          "attempted_on",
          "solved",
          "duration_seconds",
          "confidence",
          "used_hint"
        ],
        "title": "AttemptRead"
      },
      "Difficulty": {
        "type": "string",
        "enum": [
          "easy",
          "medium",
          "hard"
        ],
        "title": "Difficulty"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LoginBody": {
        "properties": {
          "username": {
            "type": "string",
            "title": "Username"
          },
          "password": {
            "type": "string",
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "LoginBody"
      },
      "Me": {
        "properties": {
          "username": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Username"
          }
        },
        "type": "object",
        "required": [
          "username"
        ],
        "title": "Me"
      },
      "Pattern": {
        "type": "string",
        "enum": [
          "arrays_hashing",
          "two_pointers",
          "sliding_window",
          "stack",
          "binary_search",
          "linked_list",
          "trees",
          "tries",
          "heap",
          "backtracking",
          "graphs",
          "advanced_graphs",
          "dp_1d",
          "dp_2d",
          "greedy",
          "intervals",
          "math_geometry",
          "bit_manipulation"
        ],
        "title": "Pattern"
      },
      "ProblemCreate": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Title"
          },
          "link": {
            "type": "string",
            "maxLength": 500,
            "title": "Link"
          },
          "pattern": {
            "$ref": "#/components/schemas/Pattern"
          },
          "difficulty": {
            "$ref": "#/components/schemas/Difficulty"
          },
          "notes": {
            "type": "string",
            "title": "Notes",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "title",
          "link",
          "pattern",
          "difficulty"
        ],
        "title": "ProblemCreate"
      },
      "ProblemRead": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "link": {
            "type": "string",
            "title": "Link"
          },
          "pattern": {
            "$ref": "#/components/schemas/Pattern"
          },
          "difficulty": {
            "$ref": "#/components/schemas/Difficulty"
          },
          "notes": {
            "type": "string",
            "title": "Notes"
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "link",
          "pattern",
          "difficulty",
          "notes"
        ],
        "title": "ProblemRead"
      },
      "QueueItem": {
        "properties": {
          "problem": {
            "$ref": "#/components/schemas/ProblemRead"
          },
          "due_on": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Due On"
          }
        },
        "type": "object",
        "required": [
          "problem",
          "due_on"
        ],
        "title": "QueueItem"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
