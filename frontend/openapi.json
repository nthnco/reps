{
  "openapi": "3.1.0",
  "info": {
    "title": "Reps API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Login",
        "operationId": "login_api_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Logout",
        "operationId": "logout_api_auth_logout_post",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Me",
        "description": "Lets the frontend decide whether to show the login page.\n\n200 means \"in\": username is null when the gate is off (local dev).",
        "operationId": "me_api_auth_me_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          }
        }
      }
    },
    "/api/problems": {
      "get": {
        "tags": [
          "problems"
        ],
        "summary": "List Problems",
        "operationId": "list_problems_api_problems_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ProblemRead"
                  },
                  "type": "array",
                  "title": "Response List Problems Api Problems Get"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "problems"
        ],
        "summary": "Create Problem",
        "operationId": "create_problem_api_problems_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProblemCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemRead"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/problems/{problem_id}/attempts": {
      "post": {
        "tags": [
          "problems"
        ],
        "summary": "Create Attempt",
        "operationId": "create_attempt_api_problems__problem_id__attempts_post",
        "parameters": [
          {
            "name": "problem_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Problem Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AttemptCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AttemptRead"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/patterns/mastery": {
      "get": {
        "tags": [
          "mastery"
        ],
        "summary": "Get Pattern Mastery",
        "description": "One row per pattern, in the fixed pattern order, including untouched ones.",
        "operationId": "get_pattern_mastery_api_patterns_mastery_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/PatternMasteryRead"
                  },
                  "type": "array",
                  "title": "Response Get Pattern Mastery Api Patterns Mastery Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/patterns/suggestion": {
      "get": {
        "tags": [
          "mastery"
        ],
        "summary": "Get Suggestion",
        "description": "Where to pick up new material; null once nothing new is left anywhere.",
        "operationId": "get_suggestion_api_patterns_suggestion_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/SuggestionRead"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "title": "Response Get Suggestion Api Patterns Suggestion Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/profile/summary": {
      "get": {
        "tags": [
          "mastery"
        ],
        "summary": "Get Profile Summary",
        "operationId": "get_profile_summary_api_profile_summary_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileSummaryRead"
                }
              }
            }
          }
        }
      }
    },
    "/api/plan/today": {
      "get": {
        "tags": [
          "plan"
        ],
        "summary": "Todays Plan",
        "operationId": "todays_plan_api_plan_today_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlanRead"
                }
              }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AttemptCreate": {
        "properties": {
          "attempted_on": {
            "type": "string",
            "format": "date",
            "title": "Attempted On"
          },
          "solved": {
            "type": "boolean",
            "title": "Solved"
          },
          "duration_seconds": {
            "type": "integer",
            "maximum": 86400.0,
            "minimum": 0.0,
            "title": "Duration Seconds"
          },
          "confidence": {
            "type": "integer",
            "maximum": 5.0,
            "minimum": 1.0,
            "title": "Confidence"
          },
          "used_hint": {
            "type": "boolean",
            "title": "Used Hint",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "solved",
          "duration_seconds",
          "confidence"
        ],
        "title": "AttemptCreate"
      },
      "AttemptRead": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "problem_id": {
            "type": "integer",
            "title": "Problem Id"
          },
          "attempted_on": {
            "type": "string",
            "format": "date",
            "title": "Attempted On"
          },
          "solved": {
            "type": "boolean",
            "title": "Solved"
          },
          "duration_seconds": {
            "type": "integer",
            "title": "Duration Seconds"
          },
          "confidence": {
            "type": "integer",
            "title": "Confidence"
          },
          "used_hint": {
            "type": "boolean",
            "title": "Used Hint"
          }
        },
        "type": "object",
        "required": [
          "id",
          "problem_id",
          "attempted_on",
          "solved",
          "duration_seconds",
          "confidence",
          "used_hint"
        ],
        "title": "AttemptRead"
      },
      "Difficulty": {
        "type": "string",
        "enum": [
          "easy",
          "medium",
          "hard"
        ],
        "title": "Difficulty"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LoginBody": {
        "properties": {
          "username": {
            "type": "string",
            "title": "Username"
          },
          "password": {
            "type": "string",
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "LoginBody"
      },
      "MasteryRulesRead": {
        "properties": {
          "overall_min_problems": {
            "type": "integer",
            "title": "Overall Min Problems"
          },
          "mastered_at": {
            "type": "number",
            "title": "Mastered At"
          },
          "strength_min_attempts": {
            "type": "integer",
            "title": "Strength Min Attempts"
          }
        },
        "type": "object",
        "required": [
          "overall_min_problems",
          "mastered_at",
          "strength_min_attempts"
        ],
        "title": "MasteryRulesRead",
        "description": "The thresholds from mastery_config, so the UI can state them exactly."
      },
      "Me": {
        "properties": {
          "username": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Username"
          }
        },
        "type": "object",
        "required": [
          "username"
        ],
        "title": "Me"
      },
      "Pattern": {
        "type": "string",
        "enum": [
          "arrays_hashing",
          "two_pointers",
          "sliding_window",
          "stack",
          "binary_search",
          "linked_list",
          "trees",
          "tries",
          "heap",
          "greedy",
          "intervals",
          "backtracking",
          "graphs",
          "advanced_graphs",
          "dp_1d",
          "dp_2d",
          "math_geometry",
          "bit_manipulation"
        ],
        "title": "Pattern"
      },
      "PatternMasteryRead": {
        "properties": {
          "pattern": {
            "$ref": "#/components/schemas/Pattern"
          },
          "displayed_mastery": {
            "type": "number",
            "title": "Displayed Mastery"
          },
          "mastery": {
            "type": "number",
            "title": "Mastery"
          },
          "peak": {
            "type": "number",
            "title": "Peak"
          },
          "certainty": {
            "type": "number",
            "title": "Certainty"
          },
          "low_data": {
            "type": "boolean",
            "title": "Low Data"
          },
          "attempt_count": {
            "type": "integer",
            "title": "Attempt Count"
          },
          "problem_count": {
            "type": "integer",
            "title": "Problem Count"
          },
          "problems_attempted": {
            "type": "integer",
            "title": "Problems Attempted"
          },
          "problems_until_counted": {
            "type": "integer",
            "title": "Problems Until Counted"
          },
          "attempts_until_trusted": {
            "type": "integer",
            "title": "Attempts Until Trusted"
          },
          "due_count": {
            "type": "integer",
            "title": "Due Count"
          },
          "last_practiced_on": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Practiced On"
          },
          "median_solve_seconds": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Median Solve Seconds"
          },
          "covered": {
            "type": "boolean",
            "title": "Covered"
          },
          "solved_by_tier": {
            "$ref": "#/components/schemas/TierCountsRead"
          },
          "total_by_tier": {
            "$ref": "#/components/schemas/TierCountsRead"
          }
        },
        "type": "object",
        "required": [
          "pattern",
          "displayed_mastery",
          "mastery",
          "peak",
          "certainty",
          "low_data",
          "attempt_count",
          "problem_count",
          "problems_attempted",
          "problems_until_counted",
          "attempts_until_trusted",
          "due_count",
          "last_practiced_on",
          "median_solve_seconds",
          "covered",
          "solved_by_tier",
          "total_by_tier"
        ],
        "title": "PatternMasteryRead"
      },
      "PlanItemRead": {
        "properties": {
          "problem": {
            "$ref": "#/components/schemas/ProblemRead"
          },
          "due_on": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Due On"
          },
          "estimate_seconds": {
            "type": "integer",
            "title": "Estimate Seconds"
          },
          "done": {
            "type": "boolean",
            "title": "Done"
          }
        },
        "type": "object",
        "required": [
          "problem",
          "due_on",
          "estimate_seconds",
          "done"
        ],
        "title": "PlanItemRead"
      },
      "PlanRead": {
        "properties": {
          "today": {
            "type": "string",
            "format": "date",
            "title": "Today"
          },
          "budget_seconds": {
            "type": "integer",
            "title": "Budget Seconds"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/PlanItemRead"
            },
            "type": "array",
            "title": "Items"
          },
          "backlog": {
            "items": {
              "$ref": "#/components/schemas/PlanItemRead"
            },
            "type": "array",
            "title": "Backlog"
          },
          "suggestion": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SuggestionRead"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "today",
          "budget_seconds",
          "items",
          "backlog",
          "suggestion"
        ],
        "title": "PlanRead"
      },
      "ProblemCreate": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Title"
          },
          "link": {
            "type": "string",
            "maxLength": 500,
            "title": "Link"
          },
          "pattern": {
            "$ref": "#/components/schemas/Pattern"
          },
          "difficulty": {
            "$ref": "#/components/schemas/Difficulty"
          },
          "notes": {
            "type": "string",
            "maxLength": 5000,
            "title": "Notes",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "title",
          "link",
          "pattern",
          "difficulty"
        ],
        "title": "ProblemCreate"
      },
      "ProblemRead": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "link": {
            "type": "string",
            "title": "Link"
          },
          "pattern": {
            "$ref": "#/components/schemas/Pattern"
          },
          "difficulty": {
            "$ref": "#/components/schemas/Difficulty"
          },
          "notes": {
            "type": "string",
            "title": "Notes"
          },
          "is_premium": {
            "type": "boolean",
            "title": "Is Premium"
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "link",
          "pattern",
          "difficulty",
          "notes",
          "is_premium"
        ],
        "title": "ProblemRead"
      },
      "ProfileSummaryRead": {
        "properties": {
          "rules": {
            "$ref": "#/components/schemas/MasteryRulesRead"
          },
          "overall": {
            "type": "number",
            "title": "Overall"
          },
          "breakdown": {
            "items": {
              "$ref": "#/components/schemas/RatingPartRead"
            },
            "type": "array",
            "title": "Breakdown"
          },
          "strengths": {
            "items": {
              "$ref": "#/components/schemas/Pattern"
            },
            "type": "array",
            "title": "Strengths"
          },
          "weaknesses": {
            "items": {
              "$ref": "#/components/schemas/Pattern"
            },
            "type": "array",
            "title": "Weaknesses"
          },
          "needs_review": {
            "items": {
              "$ref": "#/components/schemas/Pattern"
            },
            "type": "array",
            "title": "Needs Review"
          },
          "not_started": {
            "items": {
              "$ref": "#/components/schemas/Pattern"
            },
            "type": "array",
            "title": "Not Started"
          },
          "total_completed": {
            "type": "integer",
            "title": "Total Completed"
          }
        },
        "type": "object",
        "required": [
          "rules",
          "overall",
          "breakdown",
          "strengths",
          "weaknesses",
          "needs_review",
          "not_started",
          "total_completed"
        ],
        "title": "ProfileSummaryRead"
      },
      "RatingPartRead": {
        "properties": {
          "pattern": {
            "$ref": "#/components/schemas/Pattern"
          },
          "weight": {
            "type": "number",
            "title": "Weight"
          },
          "displayed_mastery": {
            "type": "number",
            "title": "Displayed Mastery"
          },
          "counted": {
            "type": "boolean",
            "title": "Counted"
          }
        },
        "type": "object",
        "required": [
          "pattern",
          "weight",
          "displayed_mastery",
          "counted"
        ],
        "title": "RatingPartRead"
      },
      "Reason": {
        "type": "string",
        "enum": [
          "start_easy",
          "next_medium",
          "step_back",
          "keep_reviewing",
          "deepen"
        ],
        "title": "Reason"
      },
      "SuggestionRead": {
        "properties": {
          "pattern": {
            "$ref": "#/components/schemas/Pattern"
          },
          "problem": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ProblemRead"
              },
              {
                "type": "null"
              }
            ]
          },
          "reason": {
            "$ref": "#/components/schemas/Reason"
          }
        },
        "type": "object",
        "required": [
          "pattern",
          "problem",
          "reason"
        ],
        "title": "SuggestionRead"
      },
      "TierCountsRead": {
        "properties": {
          "easy": {
            "type": "integer",
            "title": "Easy"
          },
          "medium": {
            "type": "integer",
            "title": "Medium"
          },
          "hard": {
            "type": "integer",
            "title": "Hard"
          }
        },
        "type": "object",
        "required": [
          "easy",
          "medium",
          "hard"
        ],
        "title": "TierCountsRead"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
